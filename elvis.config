[
    {config, [
        #{
            files => ["src/**/*.erl"],
            rules => [
                %% Keep
                {elvis_style, no_macros, disable},
                {elvis_style, atom_naming_convention, #{
                    regex => "^[a-z](_?[a-zA-Z0-9]+)*(_SUITE)?$"
                }},
                %% Since OTP28
                {elvis_style, prefer_strict_generators, disable},
                %% New in elvis_core 5.x - disable for now
                {elvis_style, prefer_sigils, disable},
                {elvis_style, consistent_ok_error_spec, disable},
                {elvis_style, abc_size, disable},
                {elvis_style, code_complexity, disable},
                {elvis_style, consistent_variable_naming, disable},
                %% Disable rules that are too strict for this codebase
                {elvis_style, no_common_caveats_call, disable},
                {elvis_style, no_init_lists, disable},
                {elvis_style, no_spec_with_records, disable},
                {elvis_style, param_pattern_matching, disable},
                {elvis_style, no_used_ignored_variables, disable},
                {elvis_style, no_throw, disable},
                {elvis_text_style, max_line_length, #{limit => 120}},
                %% await/3 has two small receive clauses for the same message
                %% on purpose: one waits, the other only peeks after a cancel.
                {elvis_style, dont_repeat_yourself, #{min_complexity => 12}},
                %% The script worker calls its adapter's callbacks, and waits for
                %% the DOWN of a runner it has just killed. wasmtime calls the
                %% {Module, Function} a caller names as a host function.
                {elvis_style, no_invalid_dynamic_calls, #{
                    ignore => [wasmtime, wasmtime_script_worker]
                }},
                {elvis_style, no_receive_without_timeout, #{ignore => [wasmtime_script_worker]}},
                %% Size limits are per module: a module that outgrows one is
                %% listed here with its reason, the limit is not raised.
                %% wasmtime is the whole public API, one module by design;
                %% wasmtime_nif is the stub table of that API.
                {elvis_style, no_god_modules, #{
                    limit => 30,
                    ignore => [wasmtime, wasmtime_nif]
                }},
                %% wasmtime_preinit carries a whole binary-format reader and
                %% writer.
                {elvis_style, max_module_length, #{
                    ignore => [wasmtime, wasmtime_preinit]
                }}
            ],
            ruleset => erl_files_strict
        },
        #{
            files => ["rebar.config"],
            ruleset => rebar_config
        }
    ]}
].
