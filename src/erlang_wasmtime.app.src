{application, erlang_wasmtime, [
    {description,
        "Wasmtime bindings for Erlang: run WebAssembly natively, call Erlang from the guest"},
    {vsn, "0.3.0"},
    {registered, [wasmtime_sup, wasmtime_module_cache, wasmtime_actor_registry]},
    {mod, {wasmtime_app, []}},
    {applications, [kernel, stdlib, crypto]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/benoitc/erlang-wasmtime"}]},
    {files, [
        "src",
        "c_src/*.c",
        "c_src/*.h",
        "priv/shims/*.cwasm",
        "priv/script_v1",
        "scripts",
        "docs",
        "examples",
        "rebar.config",
        "README.md",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "RELEASING.md",
        "LICENSE"
    ]}
]}.
