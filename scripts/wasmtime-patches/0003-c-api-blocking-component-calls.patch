+/**
+ * \file wasmtime/component/blocking.h
+ *
+ * \brief Component calls that block the calling thread and can be cancelled.
+ *
+ * Each of these runs the async form of an operation to completion on the
+ * calling thread, inside the Tokio runtime WASI uses. They are for stores
+ * whose linker holds async host functions.
+ */
+
+#ifndef WASMTIME_COMPONENT_BLOCKING_H
+#define WASMTIME_COMPONENT_BLOCKING_H
+
+#include <wasmtime/conf.h>
+
+#if defined(WASMTIME_FEATURE_COMPONENT_MODEL_ASYNC) &&                         \
+    defined(WASMTIME_FEATURE_WASI)
+
+#include <wasm.h>
+#include <wasmtime/component/component.h>
+#include <wasmtime/component/func.h>
+#include <wasmtime/component/instance.h>
+#include <wasmtime/component/linker.h>
+#include <wasmtime/component/val.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/// \brief A request to stop one blocking operation.
+typedef struct wasmtime_cancel_t wasmtime_cancel_t;
+
+/// \brief Creates a cancel handle, to be used for one operation.
+WASM_API_EXTERN wasmtime_cancel_t *wasmtime_cancel_new(void);
+
+/// \brief Cancels the operation using this handle. Callable from any thread,
+/// before or during the operation.
+WASM_API_EXTERN void wasmtime_cancel_fire(const wasmtime_cancel_t *cancel);
+
+/// \brief Deletes a cancel handle no operation is using.
+WASM_API_EXTERN void wasmtime_cancel_delete(wasmtime_cancel_t *cancel);
+
+/**
+ * \brief Like #wasmtime_component_linker_instantiate, blocking.
+ *
+ * A cancelled operation returns an error. A store whose operation was
+ * cancelled must not run guest code again.
+ */
+WASM_API_EXTERN wasmtime_error_t *
+wasmtime_component_linker_instantiate_blocking(
+    const wasmtime_component_linker_t *linker, wasmtime_context_t *context,
+    const wasmtime_component_t *component, const wasmtime_cancel_t *cancel,
+    wasmtime_component_instance_t *instance_out);
+
+/// \brief Like #wasmtime_component_func_call, blocking; also calls `async`
+/// functions.
+WASM_API_EXTERN wasmtime_error_t *wasmtime_component_func_call_blocking(
+    const wasmtime_component_func_t *func, wasmtime_context_t *context,
+    const wasmtime_component_val_t *args, size_t args_size,
+    wasmtime_component_val_t *results, size_t results_size,
+    const wasmtime_cancel_t *cancel);
+
+/// \brief Like #wasmtime_component_resource_any_drop, blocking.
+WASM_API_EXTERN wasmtime_error_t *wasmtime_component_resource_any_drop_blocking(
+    wasmtime_context_t *context, const wasmtime_component_resource_any_t *resource,
+    const wasmtime_cancel_t *cancel);
+
+/**
+ * \brief Like #wasmtime_component_linker_instance_add_func, for an import
+ * declared `async func`. The callback blocks the store's thread until it
+ * returns.
+ */
+WASM_API_EXTERN wasmtime_error_t *
+wasmtime_component_linker_instance_add_func_concurrent_blocking(
+    wasmtime_component_linker_instance_t *linker_instance, const char *name,
+    size_t name_len, wasmtime_component_func_callback_t callback, void *data,
+    void (*finalizer)(void *));
+
+#ifdef __cplusplus
+} // extern "C"
+#endif
+
+#endif // WASMTIME_FEATURE_COMPONENT_MODEL_ASYNC && WASMTIME_FEATURE_WASI
+
+#endif // WASMTIME_COMPONENT_BLOCKING_H
diff --git a/crates/c-api/src/component/blocking.rs b/crates/c-api/src/component/blocking.rs
new file mode 100644
index 0000000..61f0a77
--- /dev/null
+++ b/crates/c-api/src/component/blocking.rs
@@ -0,0 +1,161 @@
+//! Calls that block the calling thread while Wasmtime's async work runs on
+//! Tokio, and that another thread can cancel.
+//!
+//! `wasmtime_call_future_poll` polls with a no-op waker and outside a Tokio
+//! runtime, which WASI timers and sockets need. An embedder that gives each
+//! store its own thread can block instead.
+
+use super::{wasmtime_component_resource_any_t, wasmtime_component_t, wasmtime_component_val_t};
+use crate::{
+    WasmtimeStoreContextMut, wasmtime_component_func_callback_t,
+    wasmtime_component_linker_instance_t, wasmtime_component_linker_t, wasmtime_error_t,
+};
+use std::ffi::c_void;
+use std::future::Future;
+use std::pin::pin;
+use tokio::sync::Notify;
+use wasmtime::AsContextMut;
+use wasmtime::component::{Func, Instance, Val};
+use wasmtime_wasi::runtime::in_tokio;
+
+pub struct wasmtime_cancel_t {
+    notify: Notify,
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn wasmtime_cancel_new() -> Box<wasmtime_cancel_t> {
+    Box::new(wasmtime_cancel_t {
+        notify: Notify::new(),
+    })
+}
+
+/// May be called from any thread, before or during the call it cancels.
+#[unsafe(no_mangle)]
+pub extern "C" fn wasmtime_cancel_fire(cancel: &wasmtime_cancel_t) {
+    cancel.notify.notify_one();
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn wasmtime_cancel_delete(_cancel: Box<wasmtime_cancel_t>) {}
+
+fn block<T>(
+    cancel: &wasmtime_cancel_t,
+    work: impl Future<Output = wasmtime::Result<T>>,
+) -> wasmtime::Result<T> {
+    in_tokio(async {
+        let mut fired = pin!(cancel.notify.notified());
+        let mut work = pin!(work);
+        std::future::poll_fn(|cx| {
+            if fired.as_mut().poll(cx).is_ready() {
+                return std::task::Poll::Ready(Err(wasmtime::format_err!("interrupted")));
+            }
+            work.as_mut().poll(cx)
+        })
+        .await
+    })
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn wasmtime_component_linker_instantiate_blocking(
+    linker: &wasmtime_component_linker_t,
+    mut context: WasmtimeStoreContextMut<'_>,
+    component: &wasmtime_component_t,
+    cancel: &wasmtime_cancel_t,
+    instance_out: &mut Instance,
+) -> Option<Box<wasmtime_error_t>> {
+    let result = block(
+        cancel,
+        linker
+            .linker
+            .instantiate_async(&mut context, &component.component),
+    );
+    crate::handle_result(result, |instance| *instance_out = instance)
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn wasmtime_component_func_call_blocking(
+    func: &Func,
+    mut context: WasmtimeStoreContextMut<'_>,
+    args: *const wasmtime_component_val_t,
+    args_len: usize,
+    results: *mut wasmtime_component_val_t,
+    results_len: usize,
+    cancel: &wasmtime_cancel_t,
+) -> Option<Box<wasmtime_error_t>> {
+    let c_args = unsafe { crate::slice_from_raw_parts(args, args_len) };
+    let c_results = unsafe { crate::slice_from_raw_parts_mut(results, results_len) };
+
+    let mut results = vec![Val::Bool(false); results_len];
+    let result = c_args
+        .iter()
+        .map(Val::try_from)
+        .collect::<wasmtime::Result<Vec<_>>>()
+        .and_then(|args| block(cancel, func.call_async(&mut context, &args, &mut results)));
+
+    crate::handle_result(result, |_| {
+        for (c_val, rust_val) in std::iter::zip(c_results, results) {
+            *c_val = wasmtime_component_val_t::from(&rust_val);
+        }
+    })
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn wasmtime_component_resource_any_drop_blocking(
+    store: WasmtimeStoreContextMut<'_>,
+    resource: &wasmtime_component_resource_any_t,
+    cancel: &wasmtime_cancel_t,
+) -> Option<Box<wasmtime_error_t>> {
+    let result = block(cancel, resource.resource.resource_drop_async(store));
+    crate::handle_result(result, |()| ())
+}
+
+/// Satisfies an `async func` import with a blocking host function. The C
+/// callback runs to completion on the store's thread, so no other task of
+/// the store makes progress meanwhile.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn wasmtime_component_linker_instance_add_func_concurrent_blocking(
+    linker_instance: &mut wasmtime_component_linker_instance_t,
+    name: *const u8,
+    name_len: usize,
+    callback: wasmtime_component_func_callback_t,
+    data: *mut c_void,
+    finalizer: Option<extern "C" fn(*mut c_void)>,
+) -> Option<Box<wasmtime_error_t>> {
+    let foreign = crate::ForeignData { data, finalizer };
+
+    let name = unsafe { crate::slice_from_raw_parts(name, name_len) };
+    let Ok(name) = std::str::from_utf8(name) else {
+        return crate::bad_utf8();
+    };
+
+    let result = linker_instance
+        .linker_instance
+        .func_new_concurrent(&name, move |accessor, ty, args, rets| {
+            let _ = &foreign;
+            let result = accessor.with(|mut access| {
+                let mut c_args = args
+                    .iter()
+                    .map(|x| wasmtime_component_val_t::from(x))
+                    .collect::<Vec<_>>();
+                let mut c_rets = vec![wasmtime_component_val_t::Bool(false); rets.len()];
+                if let Some(err) = callback(
+                    foreign.data,
+                    access.as_context_mut(),
+                    &ty.into(),
+                    c_args.as_mut_ptr(),
+                    c_args.len(),
+                    c_rets.as_mut_ptr(),
+                    c_rets.len(),
+                ) {
+                    return Err((*err).into());
+                }
+                for (rust_val, c_val) in std::iter::zip(rets, c_rets) {
+                    *rust_val = Val::try_from(&c_val)?;
+                }
+                Ok(())
+            });
+            Box::pin(std::future::ready(result))
+        });
+
+    crate::handle_result(result, |_| ())
+}
