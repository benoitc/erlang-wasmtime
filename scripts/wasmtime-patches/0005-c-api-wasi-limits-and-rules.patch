+/// Hooks sending requests as the default does, within limits.
+#[cfg(feature = "default-send-request")]
+#[derive(Clone, Default)]
+pub struct LimitedHooks {
+    /// The addresses requests may connect to; any when `None`.
+    pub allow: Option<crate::AddressFilter>,
+    /// The most bytes of data in the body of a request, and in that of a
+    /// response.
+    pub max_body: Option<u64>,
+}
+
+#[cfg(feature = "default-send-request")]
+impl WasiHttpHooks for LimitedHooks {
+    fn send_request(
+        &mut self,
+        request: http::Request<WasiBody>,
+        options: Option<RequestOptions>,
+        fut: Box<dyn Future<Output = Result<(), Error>> + Send>,
+    ) -> Box<
+        dyn Future<
+                Output = Result<(
+                    http::Response<WasiBody>,
+                    Box<dyn Future<Output = Result<(), Error>> + Send>,
+                )>,
+            > + Send,
+    > {
+        _ = fut;
+        let allow = self.allow.clone();
+        let max = self.max_body;
+        Box::new(async move {
+            use http_body_util::BodyExt;
+
+            let request =
+                request.map(|body| CappedBody::wrap(body, max, Error::HttpRequestBodySize));
+            let (res, io) = crate::default_send_request_to(request, options, allow).await?;
+            let res = res.map(|body| {
+                CappedBody::wrap(body.boxed_unsync(), max, Error::HttpResponseBodySize)
+            });
+            Ok((res, Box::new(io) as Box<dyn Future<Output = _> + Send>))
+        })
+    }
+}
+
+/// A body which fails once more than `max` bytes of data have come through.
+#[cfg(feature = "default-send-request")]
+struct CappedBody {
+    inner: WasiBody,
+    max: u64,
+    left: u64,
+    error: fn(Option<u64>) -> Error,
+}
+
+#[cfg(feature = "default-send-request")]
+impl CappedBody {
+    fn wrap(body: WasiBody, max: Option<u64>, error: fn(Option<u64>) -> Error) -> WasiBody {
+        use http_body_util::BodyExt;
+
+        match max {
+            None => body,
+            Some(max) => CappedBody {
+                inner: body,
+                max,
+                left: max,
+                error,
+            }
+            .boxed_unsync(),
+        }
+    }
+}
+
+#[cfg(feature = "default-send-request")]
+impl http_body::Body for CappedBody {
+    type Data = Bytes;
+    type Error = Error;
+
+    fn poll_frame(
+        mut self: core::pin::Pin<&mut Self>,
+        cx: &mut core::task::Context<'_>,
+    ) -> core::task::Poll<Option<Result<http_body::Frame<Bytes>, Error>>> {
+        use core::task::Poll;
+
+        let frame = core::task::ready!(core::pin::Pin::new(&mut self.inner).poll_frame(cx));
+        if let Some(Ok(frame)) = &frame {
+            if let Some(data) = frame.data_ref() {
+                let len = data.len() as u64;
+                if len > self.left {
+                    let error = (self.error)(Some(self.max));
+                    return Poll::Ready(Some(Err(error)));
+                }
+                self.left -= len;
+            }
+        }
+        Poll::Ready(frame)
+    }
+
+    fn is_end_stream(&self) -> bool {
+        self.inner.is_end_stream()
+    }
+
+    fn size_hint(&self) -> http_body::SizeHint {
+        self.inner.size_hint()
+    }
+}
