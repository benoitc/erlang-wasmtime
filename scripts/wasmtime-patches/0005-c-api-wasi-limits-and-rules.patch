+/// One address rule: a transport, a direction, an address prefix and a port
+/// range. IPv4 addresses use the first four bytes of `addr`.
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct wasi_net_rule_t {
+    udp: u8,
+    listen: u8,
+    is_v6: u8,
+    prefix: u8,
+    port_lo: u16,
+    port_hi: u16,
+    addr: [u8; 16],
+}
+
+impl wasi_net_rule_t {
+    fn allows(&self, udp: bool, listen: bool, addr: SocketAddr) -> bool {
+        if (self.udp != 0) != udp || (self.listen != 0) != listen {
+            return false;
+        }
+        if addr.port() < self.port_lo || addr.port() > self.port_hi {
+            return false;
+        }
+        // an IPv4-mapped IPv6 address reaches the IPv4 host
+        match addr.ip().to_canonical() {
+            IpAddr::V4(ip) if self.is_v6 == 0 => {
+                prefix_matches(&ip.octets(), &self.addr[..4], self.prefix)
+            }
+            IpAddr::V6(ip) if self.is_v6 != 0 => {
+                prefix_matches(&ip.octets(), &self.addr, self.prefix)
+            }
+            _ => false,
+        }
+    }
+}
+
+fn prefix_matches(addr: &[u8], net: &[u8], prefix: u8) -> bool {
+    let mut left = usize::from(prefix);
+    for (a, n) in addr.iter().zip(net) {
+        if left == 0 {
+            return true;
+        }
+        let bits = left.min(8);
+        let mask = !0u8 << (8 - bits);
+        if a & mask != n & mask {
+            return false;
+        }
+        left -= bits;
+    }
+    true
+}
+
+pub(crate) fn any_allows(
+    rules: &[wasi_net_rule_t],
+    udp: bool,
+    listen: bool,
+    addr: SocketAddr,
+) -> bool {
+    rules.iter().any(|rule| rule.allows(udp, listen, addr))
+}
+
+pub(crate) unsafe fn rules_vec(rules: *const wasi_net_rule_t, len: usize) -> Vec<wasi_net_rule_t> {
+    if len == 0 {
+        Vec::new()
+    } else {
+        std::slice::from_raw_parts(rules, len).to_vec()
+    }
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn wasi_config_set_net_rules(
+    config: &mut wasi_config_t,
+    rules: *const wasi_net_rule_t,
+    len: usize,
+) {
+    let rules = Arc::new(rules_vec(rules, len));
+    config.builder.socket_addr_check(move |addr, reason| {
+        let allowed = match reason {
+            SocketAddrUse::TcpConnect => any_allows(&rules, false, false, addr),
+            SocketAddrUse::UdpSend => any_allows(&rules, true, false, addr),
+            SocketAddrUse::TcpListen => any_allows(&rules, false, true, addr),
+            // binding a port the system chooses gives nothing away; naming a
+            // port is claiming it, which takes a listen rule
+            SocketAddrUse::TcpBind => addr.port() == 0 || any_allows(&rules, false, true, addr),
+            SocketAddrUse::UdpBind => addr.port() == 0 || any_allows(&rules, true, true, addr),
+            // inbound on a socket whose listening or binding was allowed
+            SocketAddrUse::TcpAccept | SocketAddrUse::UdpReceive => true,
+        };
+        Box::pin(async move { allowed })
+    });
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn wasi_config_set_initial_cwd(
+    config: &mut wasi_config_t,
+    path: *const c_char,
+) -> bool {
+    match cstr_to_str(path) {
+        Some(path) => {
+            config.builder.initial_cwd(path);
+            true
+        }
+        None => false,
+    }
+}
