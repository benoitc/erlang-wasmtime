+    /// The guest's timeouts.
+    pub options: Option<RequestOptions>,
+}
+
+/// Sends one request and answers with the whole response.
+#[cfg(feature = "default-send-request")]
+pub type Transport = Arc<
+    dyn Fn(
+            Outgoing,
+        )
+            -> std::pin::Pin<Box<dyn Future<Output = Result<http::Response<Bytes>, Error>> + Send>>
+        + Send
+        + Sync,
+>;
+
+/// Sends `request` through `transport`.
+#[cfg(feature = "default-send-request")]
+async fn send_through(
+    transport: Transport,
+    request: http::Request<WasiBody>,
+    options: Option<RequestOptions>,
+    allow: Option<crate::AddressFilter>,
+    deny_names: bool,
+) -> Result<http::Response<Bytes>> {
+    use http_body_util::BodyExt;
+
+    let (parts, body) = request.into_parts();
+    let authority = parts.uri.authority().ok_or(Error::HttpRequestUriInvalid)?;
+    let default_port = if parts.uri.scheme() == Some(&http::uri::Scheme::HTTPS) {
+        443
+    } else {
+        80
+    };
+    let host = authority
+        .host()
+        .trim_start_matches('[')
+        .trim_end_matches(']')
+        .to_string();
+    let target = format!(
+        "{}:{}",
+        authority.host(),
+        authority.port_u16().unwrap_or(default_port)
+    );
+    let body = body.collect().await?.to_bytes();
+    let address = crate::resolve_authority(&target, allow.as_ref(), deny_names).await?[0];
+    transport(Outgoing {
+        parts,
+        body,
+        host,
+        address,
+        options,
+    })
+    .await
 }
 
