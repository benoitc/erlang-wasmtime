--- /dev/null
+++ b/crates/c-api/src/component/serve.rs
@@ -0,0 +1,380 @@
+//! One HTTP request given to a `wasi:http` handler, its response delivered to
+//! the embedder as the guest makes it.
+
+use super::blocking::{block, wasmtime_cancel_t};
+use crate::{WasmtimeStoreContextMut, WasmtimeStoreData, wasm_byte_vec_t, wasmtime_error_t};
+use bytes::Bytes;
+use futures::future::{Either, select};
+use http_body_util::{BodyExt, Full};
+use std::ffi::c_void;
+use std::fmt::Debug;
+use std::pin::pin;
+use tokio::sync::oneshot;
+use wasmtime::component::Instance;
+use wasmtime::{AsContextMut, Result};
+use wasmtime_wasi_http::p2::bindings::http::types as p2_types;
+use wasmtime_wasi_http::{FieldMap, WasiHttpCtxView, WasiHttpView, p2, p3};
+
+#[repr(C)]
+pub struct wasmtime_http_field_t {
+    name: *const u8,
+    name_len: usize,
+    value: *const u8,
+    value_len: usize,
+}
+
+#[repr(C)]
+pub struct wasmtime_http_request_t {
+    method: *const u8,
+    method_len: usize,
+    scheme: *const u8,
+    scheme_len: usize,
+    authority: *const u8,
+    authority_len: usize,
+    path: *const u8,
+    path_len: usize,
+    headers: *const wasmtime_http_field_t,
+    headers_len: usize,
+    body: *const u8,
+    body_len: usize,
+    trailers: *const wasmtime_http_field_t,
+    trailers_len: usize,
+}
+
+#[repr(C)]
+pub struct wasmtime_http_sink_t {
+    data: *mut c_void,
+    head: extern "C" fn(*mut c_void, u16, *const wasmtime_http_field_t, usize) -> bool,
+    chunk: extern "C" fn(*mut c_void, *const u8, usize) -> bool,
+    done: extern "C" fn(*mut c_void, *const wasmtime_http_field_t, usize) -> bool,
+}
+
+// The callbacks run on the thread that blocks in the call.
+unsafe impl Sync for wasmtime_http_sink_t {}
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub enum wasmtime_http_outcome_t {
+    Served,
+    NoHandler,
+    NoResponse,
+    ErrorCode,
+    Stopped,
+    BadRequest,
+}
+
+#[repr(C)]
+pub struct wasmtime_http_result_t {
+    outcome: wasmtime_http_outcome_t,
+    p3: bool,
+    detail: wasm_byte_vec_t,
+}
+
+type Outcome = (wasmtime_http_outcome_t, String);
+
+fn outcome(kind: wasmtime_http_outcome_t) -> Outcome {
+    (kind, String::new())
+}
+
+fn error_code(code: impl Debug) -> Outcome {
+    (wasmtime_http_outcome_t::ErrorCode, format!("{code:?}"))
+}
+
+/// A request body: the bytes, then the trailers when there are any.
+type RequestBody = http_body_util::combinators::UnsyncBoxBody<Bytes, wasmtime_wasi_http::Error>;
+
+struct Incoming {
+    method: http::Method,
+    scheme: http::uri::Scheme,
+    authority: http::uri::Authority,
+    path: http::uri::PathAndQuery,
+    headers: http::HeaderMap,
+    body: RequestBody,
+}
+
+unsafe fn bytes<'a>(ptr: *const u8, len: usize) -> &'a [u8] {
+    unsafe { crate::slice_from_raw_parts(ptr, len) }
+}
+
+unsafe fn field_map(
+    fields: *const wasmtime_http_field_t,
+    len: usize,
+) -> Result<http::HeaderMap, &'static str> {
+    let mut map = http::HeaderMap::new();
+    for field in unsafe { crate::slice_from_raw_parts(fields, len) } {
+        let name = unsafe { bytes(field.name, field.name_len) };
+        let value = unsafe { bytes(field.value, field.value_len) };
+        let name = http::HeaderName::from_bytes(name).map_err(|_| "invalid field name")?;
+        let value = http::HeaderValue::from_bytes(value).map_err(|_| "invalid field value")?;
+        // `append` panics past the map's capacity
+        map.try_append(name, value).map_err(|_| "too many fields")?;
+    }
+    Ok(map)
+}
+
+impl Incoming {
+    unsafe fn new(request: &wasmtime_http_request_t) -> Result<Incoming, &'static str> {
+        let (method, scheme, authority, path, body) = unsafe {
+            (
+                bytes(request.method, request.method_len),
+                bytes(request.scheme, request.scheme_len),
+                bytes(request.authority, request.authority_len),
+                bytes(request.path, request.path_len),
+                bytes(request.body, request.body_len),
+            )
+        };
+        let headers = unsafe { field_map(request.headers, request.headers_len)? };
+        let trailers = unsafe { field_map(request.trailers, request.trailers_len)? };
+        let trailers = (!trailers.is_empty()).then_some(Ok(trailers));
+        let body = Full::new(Bytes::copy_from_slice(body))
+            .with_trailers(std::future::ready(trailers))
+            .map_err(|e: std::convert::Infallible| match e {})
+            .boxed_unsync();
+        Ok(Incoming {
+            method: http::Method::from_bytes(method).map_err(|_| "invalid method")?,
+            scheme: http::uri::Scheme::try_from(scheme).map_err(|_| "invalid scheme")?,
+            authority: http::uri::Authority::try_from(authority)
+                .map_err(|_| "invalid authority")?,
+            path: http::uri::PathAndQuery::try_from(path).map_err(|_| "invalid path")?,
+            headers,
+            body,
+        })
+    }
+}
+
+fn view(data: &mut WasmtimeStoreData) -> WasiHttpCtxView<'_> {
+    data.http()
+}
+
+fn fields(map: &http::HeaderMap) -> Vec<wasmtime_http_field_t> {
+    map.iter()
+        .map(|(name, value)| wasmtime_http_field_t {
+            name: name.as_str().as_ptr(),
+            name_len: name.as_str().len(),
+            value: value.as_bytes().as_ptr(),
+            value_len: value.as_bytes().len(),
+        })
+        .collect()
+}
+
+async fn deliver<B>(response: http::Response<B>, sink: &wasmtime_http_sink_t) -> Outcome
+where
+    B: http_body::Body<Data = Bytes>,
+    B::Error: Debug,
+{
+    let (parts, body) = response.into_parts();
+    let headers = fields(&parts.headers);
+    if !(sink.head)(
+        sink.data,
+        parts.status.as_u16(),
+        headers.as_ptr(),
+        headers.len(),
+    ) {
+        return outcome(wasmtime_http_outcome_t::Stopped);
+    }
+    let mut body = pin!(body);
+    let mut trailers = http::HeaderMap::new();
+    while let Some(frame) = body.frame().await {
+        let frame = match frame {
+            Ok(frame) => frame,
+            Err(e) => return error_code(e),
+        };
+        match frame.into_data() {
+            Ok(data) => {
+                if !data.is_empty() && !(sink.chunk)(sink.data, data.as_ptr(), data.len()) {
+                    return outcome(wasmtime_http_outcome_t::Stopped);
+                }
+            }
+            Err(frame) => {
+                if let Ok(map) = frame.into_trailers() {
+                    trailers = map;
+                }
+            }
+        }
+    }
+    let trailers = fields(&trailers);
+    if !(sink.done)(sink.data, trailers.as_ptr(), trailers.len()) {
+        return outcome(wasmtime_http_outcome_t::Stopped);
+    }
+    outcome(wasmtime_http_outcome_t::Served)
+}
+
+async fn serve_p2(
+    mut store: WasmtimeStoreContextMut<'_>,
+    proxy: p2::bindings::Proxy,
+    request: Incoming,
+    sink: &wasmtime_http_sink_t,
+) -> Result<Outcome> {
+    let scheme = match request.scheme.as_str() {
+        "http" => p2_types::Scheme::Http,
+        "https" => p2_types::Scheme::Https,
+        other => p2_types::Scheme::Other(other.to_string()),
+    };
+    let uri = http::Uri::builder()
+        .scheme(request.scheme)
+        .authority(request.authority)
+        .path_and_query(request.path)
+        .build()?;
+    let mut incoming = http::Request::new(request.body);
+    *incoming.method_mut() = request.method;
+    *incoming.uri_mut() = uri;
+    *incoming.headers_mut() = request.headers;
+
+    let (tx, mut rx) = oneshot::channel();
+    let incoming = view(store.data_mut()).new_incoming_request(scheme, incoming)?;
+    let outparam = view(store.data_mut()).new_response_outparam(tx)?;
+    let call = proxy
+        .wasi_http_incoming_handler()
+        .func_handle()
+        .start_call_concurrent(store.as_context_mut(), (incoming, outparam))?;
+
+    store
+        .run_concurrent(async move |accessor| -> Result<Outcome> {
+            let mut handle = pin!(
+                proxy
+                    .wasi_http_incoming_handler()
+                    .func_handle()
+                    .finish_call_concurrent(accessor, call)
+            );
+            // The guest may set the response long before it returns.
+            let (response, returned) = match select(handle.as_mut(), &mut rx).await {
+                Either::Left((result, rx)) => {
+                    result?;
+                    match rx.try_recv() {
+                        Ok(response) => (response, true),
+                        Err(_) => return Ok(outcome(wasmtime_http_outcome_t::NoResponse)),
+                    }
+                }
+                Either::Right((Ok(response), _)) => (response, false),
+                Either::Right((Err(_), _)) => {
+                    handle.await?;
+                    return Ok(outcome(wasmtime_http_outcome_t::NoResponse));
+                }
+            };
+            let served = match response {
+                Err(code) => {
+                    if !returned {
+                        handle.await?;
+                    }
+                    return Ok(error_code(code));
+                }
+                Ok(response) if returned => deliver(response, sink).await,
+                Ok(response) => {
+                    let body = pin!(deliver(response, sink));
+                    match select(handle, body).await {
+                        Either::Left((result, body)) => {
+                            result?;
+                            body.await
+                        }
+                        Either::Right((served, handle)) => {
+                            if matches!(served.0, wasmtime_http_outcome_t::Served) {
+                                handle.await?;
+                            }
+                            served
+                        }
+                    }
+                }
+            };
+            finish(accessor, served).await
+        })
+        .await?
+}
+
+/// Runs what the guest still has going once its response is out.
+async fn finish(
+    accessor: &wasmtime::component::Accessor<WasmtimeStoreData>,
+    served: Outcome,
+) -> Result<Outcome> {
+    if matches!(served.0, wasmtime_http_outcome_t::Served) {
+        std::future::poll_fn(|cx| accessor.poll_no_interesting_tasks(cx)).await;
+    }
+    Ok(served)
+}
+
+async fn serve_p3(
+    mut store: WasmtimeStoreContextMut<'_>,
+    service: p3::bindings::Service,
+    request: Incoming,
+    sink: &wasmtime_http_sink_t,
+) -> Result<Outcome> {
+    let headers = FieldMap::new_immutable(view(store.data_mut()).hooks, request.headers);
+    let (incoming, request_io) = p3::Request::new(
+        request.method,
+        Some(request.scheme),
+        Some(request.authority),
+        Some(request.path),
+        headers,
+        None,
+        request.body,
+    );
+    let incoming = view(store.data_mut()).table.push(incoming)?;
+    let call = service
+        .wasi_http_handler()
+        .func_handle()
+        .start_call_concurrent(store.as_context_mut(), (incoming,))?;
+
+    store
+        .run_concurrent(async move |accessor| -> Result<Outcome> {
+            let response = service
+                .wasi_http_handler()
+                .func_handle()
+                .finish_call_concurrent(accessor, call)
+                .await?
+                .0;
+            let response = match response {
+                Ok(response) => response,
+                Err(code) => return Ok(error_code(code)),
+            };
+            let response = accessor.with(|mut access| {
+                let response = view(access.get()).table.delete(response)?;
+                response.into_http_with_getter(&mut access, request_io, view)
+            })?;
+            let served = deliver(response, sink).await;
+            finish(accessor, served).await
+        })
+        .await?
+}
+
+async fn serve(
+    mut store: WasmtimeStoreContextMut<'_>,
+    instance: Instance,
+    request: Incoming,
+    sink: &wasmtime_http_sink_t,
+    p3_out: &mut bool,
+) -> Result<Outcome> {
+    if let Ok(service) = p3::bindings::Service::new(store.as_context_mut(), &instance) {
+        *p3_out = true;
+        return serve_p3(store, service, request, sink).await;
+    }
+    match p2::bindings::Proxy::new(store.as_context_mut(), &instance) {
+        Ok(proxy) => serve_p2(store, proxy, request, sink).await,
+        Err(_) => Ok(outcome(wasmtime_http_outcome_t::NoHandler)),
+    }
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn wasmtime_component_serve_http_blocking(
+    mut context: WasmtimeStoreContextMut<'_>,
+    instance: &Instance,
+    request: &wasmtime_http_request_t,
+    sink: &wasmtime_http_sink_t,
+    cancel: &wasmtime_cancel_t,
+    result: &mut wasmtime_http_result_t,
+) -> Option<Box<wasmtime_error_t>> {
+    let data = context.data_mut();
+    // the view of the store panics without either
+    if data.wasi.is_none() || data.wasi_http.is_none() {
+        let err = wasmtime::format_err!("the store has no wasi:http context");
+        return Some(Box::new(wasmtime_error_t::from(err)));
+    }
+    let mut p3 = false;
+    let served = match unsafe { Incoming::new(request) } {
+        Ok(incoming) => block(cancel, serve(context, *instance, incoming, sink, &mut p3)),
+        Err(why) => Ok((wasmtime_http_outcome_t::BadRequest, why.to_string())),
+    };
+    crate::handle_result(served, |(kind, detail)| {
+        result.outcome = kind;
+        result.p3 = p3;
+        result.detail = wasm_byte_vec_t::from(detail.into_bytes());
+    })
+}
