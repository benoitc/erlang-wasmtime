 /// A predicate on the address an outgoing request is about to connect to.
 pub type AddressFilter = std::sync::Arc<dyn Fn(std::net::SocketAddr) -> bool + Send + Sync>;
 
+/// The addresses `authority` (`host:port`) may be reached at: resolved once,
+/// then filtered by `allow`.
+///
+/// With `deny_names`, a host that is not an address fails with
+/// [`Error::HttpRequestDenied`] before it is looked up, as does a request with
+/// no accepted address. A lookup that finds nothing is [`Error::DnsError`].
+pub async fn resolve_authority(
+    authority: &str,
+    allow: Option<&AddressFilter>,
+    deny_names: bool,
+) -> Result<Vec<std::net::SocketAddr>, Error> {
+    if deny_names {
+        let host = authority
+            .parse::<http::uri::Authority>()
+            .map_err(|_| Error::HttpRequestUriInvalid)?;
+        let host = host.host().trim_start_matches('[').trim_end_matches(']');
+        if host.parse::<std::net::IpAddr>().is_err() {
+            return Err(Error::HttpRequestDenied);
+        }
+    }
+    let unresolved = || Error::DnsError {
+        rcode: None,
+        info_code: None,
+    };
+    let found: Vec<_> = tokio::net::lookup_host(authority)
+        .await
+        .map_err(|_| unresolved())?
+        .collect();
+    if found.is_empty() {
+        return Err(unresolved());
+    }
+    let accepted: Vec<_> = found
+        .into_iter()
+        .filter(|addr| allow.is_none_or(|allow| allow(*addr)))
+        .collect();
+    if accepted.is_empty() {
+        return Err(Error::HttpRequestDenied);
+    }
+    Ok(accepted)
+}
