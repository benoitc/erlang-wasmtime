index 0000000..30109bb
--- /dev/null
+++ b/crates/c-api/src/component/transport.rs
@@ -0,0 +1,245 @@
+//! Outgoing `wasi:http` requests handed to the embedder, which answers each
+//! later from any thread.
+
+use super::serve::{bytes, field_map, fields, wasmtime_http_field_t};
+use crate::{ForeignData, WasmtimeStoreContextMut};
+use bytes::Bytes;
+use std::ffi::c_void;
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::sync::oneshot;
+use wasmtime_wasi_http::{Error, LimitedHooks, Outgoing};
+
+#[repr(C)]
+pub struct wasmtime_http_outgoing_t {
+    method: *const u8,
+    method_len: usize,
+    scheme: *const u8,
+    scheme_len: usize,
+    host: *const u8,
+    host_len: usize,
+    address: *const u8,
+    address_len: usize,
+    port: u16,
+    path: *const u8,
+    path_len: usize,
+    headers: *const wasmtime_http_field_t,
+    headers_len: usize,
+    body: *const u8,
+    body_len: usize,
+    connect_timeout_ms: u64,
+    first_byte_timeout_ms: u64,
+    between_bytes_timeout_ms: u64,
+}
+
+type Answer = Result<http::Response<Bytes>, Error>;
+
+pub struct wasmtime_http_responder_t {
+    answer: oneshot::Sender<Answer>,
+}
+
+type wasmtime_http_transport_t =
+    extern "C" fn(*mut c_void, *const wasmtime_http_outgoing_t, Box<wasmtime_http_responder_t>);
+
+fn response(status: u16, headers: http::HeaderMap, body: &[u8]) -> Answer {
+    let mut response = http::Response::new(Bytes::copy_from_slice(body));
+    *response.status_mut() =
+        http::StatusCode::from_u16(status).map_err(|_| Error::HttpProtocolError)?;
+    *response.headers_mut() = headers;
+    Ok(response)
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn wasmtime_http_responder_respond(
+    responder: Box<wasmtime_http_responder_t>,
+    status: u16,
+    headers: *const wasmtime_http_field_t,
+    headers_len: usize,
+    body: *const u8,
+    body_len: usize,
+) {
+    let answer = match unsafe { field_map(headers, headers_len) } {
+        Ok(headers) => response(status, headers, unsafe { bytes(body, body_len) }),
+        Err(_) => Err(Error::HttpProtocolError),
+    };
+    _ = responder.answer.send(answer);
+}
+
+fn error_code(name: &[u8], size: Option<u64>, text: Option<String>) -> Error {
+    let short = size.and_then(|n| u32::try_from(n).ok());
+    match name {
+        b"DNS-timeout" => Error::DnsTimeout,
+        b"DNS-error" => Error::DnsError {
+            rcode: None,
+            info_code: None,
+        },
+        b"destination-not-found" => Error::DestinationNotFound,
+        b"destination-unavailable" => Error::DestinationUnavailable,
+        b"destination-IP-prohibited" => Error::DestinationIpProhibited,
+        b"destination-IP-unroutable" => Error::DestinationIpUnroutable,
+        b"connection-refused" => Error::ConnectionRefused,
+        b"connection-terminated" => Error::ConnectionTerminated,
+        b"connection-timeout" => Error::ConnectionTimeout,
+        b"connection-read-timeout" => Error::ConnectionReadTimeout,
+        b"connection-write-timeout" => Error::ConnectionWriteTimeout,
+        b"connection-limit-reached" => Error::ConnectionLimitReached,
+        b"TLS-protocol-error" => Error::TlsProtocolError,
+        b"TLS-certificate-error" => Error::TlsCertificateError,
+        b"TLS-alert-received" => Error::TlsAlertReceived {
+            alert_id: None,
+            alert_message: None,
+        },
+        b"HTTP-request-denied" => Error::HttpRequestDenied,
+        b"HTTP-request-length-required" => Error::HttpRequestLengthRequired,
+        b"HTTP-request-body-size" => Error::HttpRequestBodySize(size),
+        b"HTTP-request-method-invalid" => Error::HttpRequestMethodInvalid,
+        b"HTTP-request-URI-invalid" => Error::HttpRequestUriInvalid,
+        b"HTTP-request-URI-too-long" => Error::HttpRequestUriTooLong,
+        b"HTTP-request-header-section-size" => Error::HttpRequestHeaderSectionSize(short),
+        b"HTTP-request-header-size" => Error::HttpRequestHeaderSize {
+            field_name: None,
+            field_size: short,
+        },
+        b"HTTP-request-trailer-section-size" => Error::HttpRequestTrailerSectionSize(short),
+        b"HTTP-request-trailer-size" => Error::HttpRequestTrailerSize {
+            field_name: None,
+            field_size: short,
+        },
+        b"HTTP-response-incomplete" => Error::HttpResponseIncomplete,
+        b"HTTP-response-header-section-size" => Error::HttpResponseHeaderSectionSize(short),
+        b"HTTP-response-header-size" => Error::HttpResponseHeaderSize {
+            field_name: None,
+            field_size: short,
+        },
+        b"HTTP-response-body-size" => Error::HttpResponseBodySize(size),
+        b"HTTP-response-trailer-section-size" => Error::HttpResponseTrailerSectionSize(short),
+        b"HTTP-response-trailer-size" => Error::HttpResponseTrailerSize {
+            field_name: None,
+            field_size: short,
+        },
+        b"HTTP-response-transfer-coding" => Error::HttpResponseTransferCoding(text),
+        b"HTTP-response-content-coding" => Error::HttpResponseContentCoding(text),
+        b"HTTP-response-timeout" => Error::HttpResponseTimeout,
+        b"HTTP-upgrade-failed" => Error::HttpUpgradeFailed,
+        b"HTTP-protocol-error" => Error::HttpProtocolError,
+        b"loop-detected" => Error::LoopDetected,
+        b"configuration-error" => Error::ConfigurationError,
+        _ => Error::InternalError(text),
+    }
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn wasmtime_http_responder_fail(
+    responder: Box<wasmtime_http_responder_t>,
+    name: *const u8,
+    name_len: usize,
+    has_size: bool,
+    size: u64,
+    text: *const u8,
+    text_len: usize,
+) {
+    let name = unsafe { bytes(name, name_len) };
+    let text = unsafe { bytes(text, text_len) };
+    let text = (!text.is_empty()).then(|| String::from_utf8_lossy(text).into_owned());
+    let error = error_code(name, has_size.then_some(size), text);
+    _ = responder.answer.send(Err(error));
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn wasmtime_http_responder_delete(_responder: Box<wasmtime_http_responder_t>) {}
+
+/// Calls the embedder and gives back what it will answer on. Nothing here is
+/// held across an await.
+fn hand_over(
+    callback: wasmtime_http_transport_t,
+    data: *mut c_void,
+    request: &Outgoing,
+) -> oneshot::Receiver<Answer> {
+    let (answer, receiver) = oneshot::channel();
+    let method = request.parts.method.as_str();
+    let scheme = request.parts.uri.scheme_str().unwrap_or("http");
+    let path = request
+        .parts
+        .uri
+        .path_and_query()
+        .map_or("/", |p| p.as_str());
+    let address = request.address.ip().to_string();
+    let headers = fields(&request.parts.headers);
+    let millis = |timeout: Option<Duration>| {
+        timeout.map_or(u64::MAX, |t| {
+            u64::try_from(t.as_millis()).unwrap_or(u64::MAX)
+        })
+    };
+    let options = request.options.unwrap_or_default();
+    let outgoing = wasmtime_http_outgoing_t {
+        method: method.as_ptr(),
+        method_len: method.len(),
+        scheme: scheme.as_ptr(),
+        scheme_len: scheme.len(),
+        host: request.host.as_ptr(),
+        host_len: request.host.len(),
+        address: address.as_ptr(),
+        address_len: address.len(),
+        port: request.address.port(),
+        path: path.as_ptr(),
+        path_len: path.len(),
+        headers: headers.as_ptr(),
+        headers_len: headers.len(),
+        body: request.body.as_ptr(),
+        body_len: request.body.len(),
+        connect_timeout_ms: millis(options.connect_timeout),
+        first_byte_timeout_ms: millis(options.first_byte_timeout),
+        between_bytes_timeout_ms: millis(options.between_bytes_timeout),
+    };
+    callback(
+        data,
+        &outgoing,
+        Box::new(wasmtime_http_responder_t { answer }),
+    );
+    receiver
+}
+
+fn hooks<'a>(context: &'a mut WasmtimeStoreContextMut<'_>) -> Option<&'a mut LimitedHooks> {
+    let data = context.data_mut();
+    data.wasi_http.as_ref()?;
+    Some(data.http_hooks.get_or_insert_default())
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn wasmtime_context_set_wasi_http_transport(
+    mut context: WasmtimeStoreContextMut<'_>,
+    callback: wasmtime_http_transport_t,
+    data: *mut c_void,
+    finalizer: Option<extern "C" fn(*mut c_void)>,
+) -> bool {
+    // dropped, and so finalized, when there is nothing to set it on
+    let foreign = Arc::new(ForeignData { data, finalizer });
+    let Some(hooks) = hooks(&mut context) else {
+        return false;
+    };
+    hooks.transport = Some(Arc::new(move |request| {
+        let foreign = foreign.clone();
+        Box::pin(async move {
+            let answer = hand_over(callback, foreign.data, &request);
+            answer.await.unwrap_or_else(|_| {
+                Err(Error::InternalError(Some(
+                    "the transport gave no answer".to_string(),
+                )))
+            })
+        })
+    }));
+    true
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn wasmtime_context_deny_wasi_http_names(
+    mut context: WasmtimeStoreContextMut<'_>,
+) -> bool {
+    match hooks(&mut context) {
+        Some(hooks) => {
+            hooks.deny_names = true;
+            true
+        }
+        None => false,
+    }
+}
