+/**
+ * \brief Allow usage of TCP through `wasi:sockets`.
+ *
+ * By default this is disabled. Which addresses may be used is decided
+ * separately, for example by #wasi_config_inherit_network.
+ */
+WASI_API_EXTERN void wasi_config_allow_tcp(wasi_config_t *config, bool enable);
+
+/**
+ * \brief Allow usage of UDP through `wasi:sockets`.
+ *
+ * By default this is disabled. Which addresses may be used is decided
+ * separately, for example by #wasi_config_inherit_network.
+ */
+WASI_API_EXTERN void wasi_config_allow_udp(wasi_config_t *config, bool enable);
