@@ -0,0 +1,114 @@
+/**
+ * \file wasmtime/component/serve.h
+ *
+ * \brief Giving one HTTP request to a `wasi:http` handler component.
+ */
+
+#ifndef WASMTIME_COMPONENT_SERVE_H
+#define WASMTIME_COMPONENT_SERVE_H
+
+#include <wasmtime/conf.h>
+
+#if defined(WASMTIME_FEATURE_COMPONENT_MODEL_ASYNC) &&                         \
+    defined(WASMTIME_FEATURE_WASI_HTTP)
+
+#include <wasm.h>
+#include <wasmtime/component/blocking.h>
+#include <wasmtime/component/instance.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/// \brief One header or trailer field.
+typedef struct wasmtime_http_field_t {
+  const uint8_t *name;
+  size_t name_len;
+  const uint8_t *value;
+  size_t value_len;
+} wasmtime_http_field_t;
+
+/// \brief A request for a handler. Every pointer is borrowed for the call.
+typedef struct wasmtime_http_request_t {
+  const uint8_t *method;
+  size_t method_len;
+  const uint8_t *scheme;
+  size_t scheme_len;
+  const uint8_t *authority;
+  size_t authority_len;
+  /// The path and query, starting with `/`, or `*`.
+  const uint8_t *path;
+  size_t path_len;
+  const wasmtime_http_field_t *headers;
+  size_t headers_len;
+  const uint8_t *body;
+  size_t body_len;
+  const wasmtime_http_field_t *trailers;
+  size_t trailers_len;
+} wasmtime_http_request_t;
+
+/**
+ * \brief Where a response goes, as the guest makes it: `head` once, `chunk`
+ * for each piece of the body, `done` once.
+ *
+ * The callbacks run on the calling thread. The guest does not run while one
+ * does, so a callback that waits for its consumer holds one chunk and slows
+ * the guest. One that returns false ends the call.
+ */
+typedef struct wasmtime_http_sink_t {
+  void *data;
+  bool (*head)(void *data, uint16_t status, const wasmtime_http_field_t *headers,
+               size_t headers_len);
+  bool (*chunk)(void *data, const uint8_t *bytes, size_t len);
+  bool (*done)(void *data, const wasmtime_http_field_t *trailers,
+               size_t trailers_len);
+} wasmtime_http_sink_t;
+
+/// \brief How serving a request ended, when the call itself did not fail.
+typedef enum wasmtime_http_outcome_t {
+  /// `done` was called: the whole response was delivered.
+  WASMTIME_HTTP_SERVED = 0,
+  /// The component exports no `wasi:http` handler.
+  WASMTIME_HTTP_NO_HANDLER,
+  /// The handler returned without a response.
+  WASMTIME_HTTP_NO_RESPONSE,
+  /// The guest answered with an error, or the response body failed; `detail`
+  /// is the error code as Rust prints it.
+  WASMTIME_HTTP_ERROR_CODE,
+  /// A sink callback returned false.
+  WASMTIME_HTTP_STOPPED,
+  /// The request cannot be one; `detail` says why.
+  WASMTIME_HTTP_BAD_REQUEST,
+} wasmtime_http_outcome_t;
+
+/// \brief The result of serving a request.
+typedef struct wasmtime_http_result_t {
+  wasmtime_http_outcome_t outcome;
+  /// Whether the handler is a WASI 0.3 one.
+  bool p3;
+  /// Text for the outcomes that have some, empty otherwise; delete it with
+  /// #wasm_byte_vec_delete.
+  wasm_byte_vec_t detail;
+} wasmtime_http_result_t;
+
+/**
+ * \brief Gives `request` to the instance's `wasi:http` handler, 0.3 or else
+ * 0.2, delivers the response to `sink`, then lets the guest finish what it
+ * still has running.
+ *
+ * The store needs a WASI context and #wasmtime_context_set_wasi_http. Errors,
+ * traps among them, are returned; otherwise `result` is filled. Blocks the
+ * calling thread; `cancel` ends it from another one.
+ */
+WASM_API_EXTERN wasmtime_error_t *wasmtime_component_serve_http_blocking(
+    wasmtime_context_t *context, const wasmtime_component_instance_t *instance,
+    const wasmtime_http_request_t *request, const wasmtime_http_sink_t *sink,
+    const wasmtime_cancel_t *cancel, wasmtime_http_result_t *result);
+
+#ifdef __cplusplus
+} // extern "C"
+#endif
+
+#endif // WASMTIME_FEATURE_COMPONENT_MODEL_ASYNC && WASMTIME_FEATURE_WASI_HTTP
+
+#endif // WASMTIME_COMPONENT_SERVE_H
